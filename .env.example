# --- What to watch ---------------------------------------------------------
# SIS term code. Fall 2026 is 1268 (UVA pattern: 1 + 2-digit-year + 8/6/2/1 for
# Fall/Summer/Spring/J-term).
SIS_TERM=1268

# The 5-digit class_nbr from SIS / Hoos' List. Look it up once and paste here.
CLASS_NBR=12345

# Friendly label used in the email subject (optional). Example: "CS 2150".
MNEMONIC=

# Poll interval in seconds. 60 is a good default; <30 will log a warning.
POLL_INTERVAL=60

# --- Email (Gmail SMTP with an App Password) -------------------------------
# Create an app password: https://myaccount.google.com/apppasswords
# (requires 2FA to be enabled on the Google account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where the alert is sent (can be your virginia.edu address).
EMAIL_TO=you@virginia.edu

# Optional: From address. Defaults to SMTP_USER. For Gmail this generally
# MUST equal SMTP_USER unless you configured a "send mail as" alias.
EMAIL_FROM=

# --- Misc ------------------------------------------------------------------
# Path to a rotating log file. Leave blank to log to stdout only.
LOG_FILE=watcher.log

# Send a one-time "I'm now watching X" email at startup. true/false.
SEND_STARTUP_EMAIL=true

# Exit cleanly after this many seconds (0 = run forever). Used by the
# GitHub Actions workflow to stay under the 6h job limit.
MAX_RUNTIME=0
